    {
      "id": 11,
      "title": "Новые пользователи",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "gigradar-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT date_trunc('day',created_at) AS \"time\", count(*) AS new_users FROM monitor_users WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Активные пользователи",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "gigradar-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT activity_date::timestamp AS \"time\", count(*) AS active_users FROM monitor_user_activity WHERE $__timeFilter(activity_date) GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Поиски с результатами и без",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "gigradar-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT date_trunc('day',occurred_at) AS \"time\", kind, outcome, count(*) AS searches FROM monitor_product_events WHERE kind IN ('concert_search','artist_search') AND $__timeFilter(occurred_at) GROUP BY 1,2,3 ORDER BY 1",
          "format": "time_series"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "title": "Добавления и удаления",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "gigradar-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT date_trunc('day',occurred_at) AS \"time\", kind, count(*) AS actions FROM monitor_product_events WHERE kind IN ('subscription_add','subscription_remove','favorite_add','favorite_remove') AND $__timeFilter(occurred_at) GROUP BY 1,2 ORDER BY 1",
          "format": "time_series"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "title": "Текущее число подписок и избранного",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "gigradar-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT (SELECT count(*) FROM monitor_subscriptions) AS subscriptions, (SELECT count(*) FROM monitor_favorites) AS favorites, (SELECT count(DISTINCT concert_id) FROM monitor_favorites) AS distinct_favorite_concerts",
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ],
  "tags": [
    "GigRadar"
  ]
}
