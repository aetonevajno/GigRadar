        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Доступные концерты на 30 дней",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "gigradar-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT c.city, count(*) AS concerts FROM monitor_concerts c WHERE c.starts_at>=now() AND c.starts_at<now()+interval '30 days' AND c.status<>'cancelled' AND EXISTS (SELECT 1 FROM monitor_source_events s WHERE s.concert_id=c.id AND s.classification='concert' AND s.is_active) GROUP BY c.city ORDER BY c.city",
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 9,
      "title": "Доля концертов с артистом",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "gigradar-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT c.city, count(*) AS concerts, count(*) FILTER (WHERE EXISTS (SELECT 1 FROM monitor_concert_artists ca WHERE ca.concert_id=c.id)) AS with_artist, round(100.0*count(*) FILTER (WHERE EXISTS (SELECT 1 FROM monitor_concert_artists ca WHERE ca.concert_id=c.id))/nullif(count(*),0),1) AS percent_with_artist FROM monitor_concerts c WHERE c.starts_at>=now() AND c.starts_at<now()+interval '30 days' AND c.status<>'cancelled' AND EXISTS (SELECT 1 FROM monitor_source_events s WHERE s.concert_id=c.id AND s.classification='concert' AND s.is_active) GROUP BY c.city",
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 10,
      "title": "Неясные классификации",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "gigradar-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT city, count(*) AS unclear FROM monitor_source_events WHERE classification='unclear' AND starts_at>=now() AND starts_at<now()+interval '30 days' GROUP BY city",
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 11,
      "title": "Артисты на проверку",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "gigradar-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT s.city, count(*) AS mentions_to_review FROM monitor_artist_mentions m JOIN monitor_source_events s ON (s.source,s.external_id)=(m.source,m.external_id) WHERE m.confidence='review' AND NOT m.reviewed AND s.starts_at>=now() GROUP BY s.city",
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
