    },
    {
      "id": 13,
      "title": "Давность last_seen_at у будущих записей",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "gigradar-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT city, count(*) AS source_records, count(*) FILTER (WHERE last_seen_at<now()-interval '12 hours') AS unseen_12h, count(*) FILTER (WHERE last_seen_at<now()-interval '24 hours') AS unseen_24h, round(max(extract(epoch from now()-last_seen_at))/3600,1) AS oldest_seen_hours FROM monitor_source_events WHERE source='timepad' AND classification='concert' AND starts_at>=now() AND starts_at<now()+interval '30 days' GROUP BY city",
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 8,
