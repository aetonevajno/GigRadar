{
  "uid": "gigradar-afisha",
  "title": "Афиша и импорт",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Последняя успешная синхронизация по городам",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "gigradar-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT cities.city, s.last_successful_at, round(extract(epoch from now()-s.last_successful_at)/3600,1) AS age_hours, s.event_count AS received, s.rejected_count AS rejected FROM (VALUES ('Москва'), ('Санкт-Петербург')) cities(city) LEFT JOIN monitor_sync_state s ON s.source='timepad' AND s.city=cities.city ORDER BY cities.city",
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2,
      "title": "Попытки импорта по исходу",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (city,outcome) (increase(gigradar_import_attempts_total[$__rate_interval]))",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Длительность импорта p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (city,outcome,le) (rate(gigradar_import_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Получено и отклонено при импорте",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (city,outcome) (increase(gigradar_import_records_total[$__range]))",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Запросы Timepad по исходу",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(gigradar_timepad_requests_total[$__range]))",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Тайм-ауты и HTTP 429 Timepad",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(gigradar_timepad_requests_total{outcome=~\"timeout|http_429\"}[$__range]))",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Повторы Timepad",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (city) (increase(gigradar_timepad_retries_total[$__range]))",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
