# Copy this file to .env and fill in the required values.
# Keep .env private; it is excluded from Git and Docker build contexts.

# Required for the local PostgreSQL and Timepad collector services.
POSTGRES_PASSWORD=
TIMEPAD_API_TOKEN=

# Required when running Python commands on the host, outside Docker.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://gigradar:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/gigradar

# Required only for the production Compose stack.
# TELEGRAM_BOT_TOKEN=
# APP_DOMAIN=

# Optional: set a private directory when running deploy/backup.sh.
# BACKUP_DIR=

# Optional: override the default local browser origin for direct API requests.
# CORS_ORIGINS=http://localhost:5173

# Optional: integration tests create an isolated schema in this database.
# TEST_DATABASE_URL=postgresql://gigradar:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/gigradar
